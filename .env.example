# Local development only. Do not reuse these credentials outside your workstation.
POSTGRES_USER="village_dev"
POSTGRES_PASSWORD="village_dev_local_only"
POSTGRES_DB="village"
POSTGRES_PORT="5432"

# PostgreSQL connection string used by Prisma CLI and the database adapter.
DATABASE_URL="postgresql://village_dev:village_dev_local_only@localhost:5432/village?schema=public"

# Base URL for local development and future absolute links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
